{
  "$schema": "https://eips.ethereum.org/assets/eip-7730/erc7730-v2.schema.json",
  "context": {
    "$id": "alUSDb on Base",
    "contract": {
      "deployments": [
        {
          "chainId": 8453,
          "address": "0x877014E21c32feA108B6A1f45f367efc9a2d9B9F"
        }
      ]
    }
  },
  "metadata": {
    "owner": "Alchemix",
    "contractName": "Alchemic USD Base",
    "token": {
      "name": "Alchemic USD Base",
      "ticker": "alUSDb",
      "decimals": 18
    }
  },
  "display": {
    "formats": {
      "transfer(address to,uint256 value)": {
        "intent": "Send",
        "interpolatedIntent": "Send {value} to {to}",
        "fields": [
          {
            "path": "value",
            "label": "Amount",
            "format": "tokenAmount",
            "params": {
              "tokenPath": "@.to"
            }
          },
          {
            "path": "to",
            "label": "To",
            "format": "addressName"
          }
        ]
      }
    }
  }
}
