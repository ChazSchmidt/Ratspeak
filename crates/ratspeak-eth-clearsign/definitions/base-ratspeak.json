{
  "$schema": "https://eips.ethereum.org/assets/eip-7730/erc7730-v2.schema.json",
  "context": {
    "$id": "RATSPEAK on Base",
    "contract": {
      "deployments": [
        {
          "chainId": 8453,
          "address": "0xf1e9Baa65d418A9025e1851DD2D37f1AD208bba3"
        }
      ]
    }
  },
  "metadata": {
    "owner": "Ratspeak",
    "contractName": "Ratspeak",
    "token": {
      "name": "Ratspeak",
      "ticker": "RATSPEAK",
      "decimals": 18
    }
  },
  "display": {
    "formats": {
      "transfer(address to,uint256 value)": {
        "intent": "Send",
        "interpolatedIntent": "Send {value} to {to}",
        "fields": [
          {
            "path": "value",
            "label": "Amount",
            "format": "tokenAmount",
            "params": {
              "tokenPath": "@.to"
            }
          },
          {
            "path": "to",
            "label": "To",
            "format": "addressName"
          }
        ]
      }
    }
  }
}
