{
  "$schema": "https://eips.ethereum.org/assets/eip-7730/erc7730-v2.schema.json",
  "context": {
    "$id": "USDC on Base Sepolia",
    "contract": {
      "deployments": [
        {
          "chainId": 84532,
          "address": "0x036CbD53842c5426634e7929541eC2318f3dCF7e"
        }
      ]
    }
  },
  "metadata": {
    "owner": "Circle",
    "contractName": "USD Coin",
    "token": {
      "name": "USD Coin",
      "ticker": "USDC",
      "decimals": 6
    }
  },
  "display": {
    "formats": {
      "transfer(address to,uint256 value)": {
        "intent": "Send",
        "interpolatedIntent": "Send {value} to {to}",
        "fields": [
          {
            "path": "value",
            "label": "Amount",
            "format": "tokenAmount",
            "params": {
              "tokenPath": "@.to"
            }
          },
          {
            "path": "to",
            "label": "To",
            "format": "addressName"
          }
        ]
      }
    }
  }
}
